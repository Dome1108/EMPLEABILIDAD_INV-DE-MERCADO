   "id": "29144e9e",
   "metadata": {},
   "source": [
    "# MATRÍCULAS, TÍTULOS Y PRECIOS — BDD_IDM MASTER\n",
    "\n",
    "Este notebook trabaja directamente con:\n",
    "- `BDD_IDM.senescyt.Matriculados_Senescyt`\n",
    "- `BDD_IDM.senescyt.Graduados_nueva`\n",
    "- `BDD_IDM.senescyt.Precios_Homologados`\n",
    "\n",
    "Usa únicamente las columnas definidas para el análisis y, en precios, toma directamente:\n",
    "- `CARRERA_HOMOLOGADA_FINAL`\n",
    "- `HOMOLOGADOS_NIVEL_ACADEMICO`\n",
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0511e603",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import unicodedata\n",
    "import re\n",
    "import pyodbc\n",
    "from IPython.display import display\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0bf07044",
   "metadata": {},
   "source": [
    "## 1. Conexión"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "712578de",
   "metadata": {},
   "outputs": [],
   "source": [
    "SERVER = r\"SNBI03\"\n",
    "DATABASE = \"BDD_IDM\"\n",
    "DRIVER = \"ODBC Driver 18 for SQL Server\"\n",
    "\n",
    "CONN_STR = (\n",
    "    f\"DRIVER={{{DRIVER}}};\"\n",
    "    f\"SERVER={SERVER};\"\n",
    "    f\"DATABASE={DATABASE};\"\n",
    "    \"Trusted_Connection=yes;\"\n",
    "    \"TrustServerCertificate=yes;\"\n",
    ")\n",
    "\n",
    "conn = pyodbc.connect(CONN_STR)\n",
    "print(\"Conectado a\", SERVER, DATABASE)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4072f42d",
   "metadata": {},
   "source": [
    "## 2. Carga de datos"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "190ad5e5",
   "metadata": {},
   "outputs": [],
   "source": [
    "query_matriculados = '''\n",
    "SELECT\n",
    "    PERIODO,\n",
    "    TIPO_FINANCIAMIENTO,\n",
    "    NIVEL_FORMACION,\n",
    "    PROVINCIA_IES,\n",
    "    NOMBRE_IES,\n",
    "    CARRERA_HOMOLOGADA,\n",
    "    TOTAL_MATRICULADOS\n",
    "FROM senescyt.Matriculados_Senescyt;\n",
    "'''\n",
    "\n",
    "query_titulados = '''\n",
    "SELECT\n",
    "    INSTITUCION_EDUCACION_SUPERIOR,\n",
    "    NIVEL_ACADEMICO,\n",
    "    CARRERA_HOMOLOGADA,\n",
    "    FECHA_REGISTRO\n",
    "FROM senescyt.Graduados_nueva;\n",
    "'''\n",
    "\n",
    "query_precios = '''\n",
    "SELECT\n",
    "    SEMESTRE_POS,\n",
    "    SIGLA,\n",
    "    FINANCIAMIENTO,\n",
    "    NIVEL_ACADEMICO,\n",
    "    CARRERA_HOMOLOGADA_FINAL,\n",
    "    ARANCEL,\n",
    "    HOMOLOGADOS_NIVEL_ACADEMICO\n",
    "FROM senescyt.Precios_Homologados;\n",
    "'''\n",
    "\n",
    "df_matriculados = pd.read_sql(query_matriculados, conn)\n",
    "df_titulados = pd.read_sql(query_titulados, conn)\n",
    "df_precios = pd.read_sql(query_precios, conn)\n",
    "\n",
    "print(\"MATRICULADOS:\", df_matriculados.shape)\n",
    "print(\"TITULADOS:\", df_titulados.shape)\n",
    "print(\"PRECIOS:\", df_precios.shape)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b870706e",
   "metadata": {},
   "source": [
    "## 3. Funciones"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5a26e3a1",
   "metadata": {},
   "outputs": [],
   "source": [
    "def normalizar_texto(valor):\n",
    "    if pd.isna(valor):\n",
    "        return pd.NA\n",
    "    texto = str(valor).strip().upper()\n",
    "    texto = \"\".join(\n",
    "        c for c in unicodedata.normalize(\"NFKD\", texto)\n",
    "        if not unicodedata.combining(c)\n",
    "    )\n",
    "    return \" \".join(texto.split())\n",
    "\n",
    "def homologar_financiamiento(serie):\n",
    "    s = serie.astype(\"string\").map(normalizar_texto)\n",
    "    return np.select(\n",
    "        [\n",
    "            s.str.contains(r\"PARTICULAR|PRIVAD\", na=False),\n",
    "            s.str.contains(r\"PUBLIC\", na=False),\n",
    "        ],\n",
    "        [\"PRIVADO\", \"PUBLICO\"],\n",
    "        default=\"NO CLASIFICADO\"\n",
    "    )\n",
    "\n",
    "MAPA_NIVELES = {\n",
    "    \"TITULO(S) DE TERCER NIVEL DE GRADO\": \"TERCER NIVEL\",\n",
    "    \"TITULS_3ER_NVL_GRD\": \"TERCER NIVEL\",\n",
    "    \"TERCER NIVEL DE GRADO\": \"TERCER NIVEL\",\n",
    "    \"3ER NIVEL\": \"TERCER NIVEL\",\n",
    "    \"TITULO(S) DE CUARTO NIVEL O POSGRADO\": \"CUARTO NIVEL\",\n",
    "    \"TITULS_4T_NVL_PSGRD\": \"CUARTO NIVEL\",\n",
    "    \"CUARTO NIVEL O POSGRADO\": \"CUARTO NIVEL\",\n",
    "    \"4TO NIVEL\": \"CUARTO NIVEL\",\n",
    "    \"TITULO(S) DE TERCER NIVEL TECNICO-TECNOLOGICO SUPERIOR\": \"TECNOLOGIA\",\n",
    "    \"TITULO(S) DE NIVEL TECNICO Y TECNOLOGICO\": \"TECNOLOGIA\",\n",
    "    \"TITULS_3ER_NVL_TEC-TECN_SUPERIR\": \"TECNOLOGIA\",\n",
    "    \"TITULS_NVL_TEC_TECN\": \"TECNOLOGIA\",\n",
    "    \"TECNOLOGIA\": \"TECNOLOGIA\",\n",
    "    \"TECNOLOGIA SUPERIOR\": \"TECNOLOGIA\",\n",
    "    \"TECNOLOGIA SUPERIOR UNIVERSITARIA\": \"TECNOLOGIA\",\n",
    "}\n",
    "\n",
    "def homologar_nivel(serie):\n",
    "    return serie.astype(\"string\").map(normalizar_texto).replace(MAPA_NIVELES)\n",
    "\n",
    "def convertir_moneda(valor):\n",
    "    if pd.isna(valor):\n",
    "        return np.nan\n",
    "    if isinstance(valor, (int, float, np.number)):\n",
    "        return float(valor)\n",
    "    texto = str(valor).strip().replace(\"$\", \"\").replace(\" \", \"\")\n",
    "    texto = re.sub(r\"[^0-9,.-]\", \"\", texto)\n",
    "    if not texto:\n",
    "        return np.nan\n",
    "    if \",\" in texto and \".\" in texto:\n",
    "        if texto.rfind(\",\") > texto.rfind(\".\"):\n",
    "            texto = texto.replace(\".\", \"\").replace(\",\", \".\")\n",
    "        else:\n",
    "            texto = texto.replace(\",\", \"\")\n",
    "    elif \",\" in texto:\n",
    "        texto = texto.replace(\",\", \".\")\n",
    "    try:\n",
    "        return float(texto)\n",
    "    except ValueError:\n",
    "        return np.nan\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ce71107e",
   "metadata": {},
   "source": [
    "## 4. Preparación de matriculados"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "608a1b1e",
   "metadata": {},
   "outputs": [],
   "source": [
    "df_matriculados[\"TOTAL_MATRICULADOS\"] = pd.to_numeric(\n",
    "    df_matriculados[\"TOTAL_MATRICULADOS\"], errors=\"coerce\"\n",
    ").fillna(0)\n",
    "\n",
    "df_matriculados[\"ANIO\"] = pd.to_numeric(\n",
    "    df_matriculados[\"PERIODO\"].astype(\"string\").str.extract(r\"(20\\d{2})\", expand=False),\n",
    "    errors=\"coerce\"\n",
    ").astype(\"Int64\")\n",
    "\n",
    "df_matriculados[\"TIPO_FINANCIAMIENTO_HOMOLOGADO\"] = homologar_financiamiento(\n",
    "    df_matriculados[\"TIPO_FINANCIAMIENTO\"]\n",
    ")\n",
    "\n",
    "df_matriculados[\"NIVEL_FORMACION_HOMOLOGADO\"] = homologar_nivel(\n",
    "    df_matriculados[\"NIVEL_FORMACION\"]\n",
    ")\n",
    "\n",
    "for col in [\"NOMBRE_IES\", \"CARRERA_HOMOLOGADA\", \"PROVINCIA_IES\"]:\n",
    "    df_matriculados[col] = df_matriculados[col].astype(\"string\").map(normalizar_texto)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c9338780",
   "metadata": {},
   "source": [
    "## 5. Preparación de graduados"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5c6cf062",
   "metadata": {},
   "outputs": [],
   "source": [
    "catalogo_fin = (\n",
    "    df_matriculados[[\"NOMBRE_IES\", \"TIPO_FINANCIAMIENTO_HOMOLOGADO\"]]\n",
    "    .dropna()\n",
    "    .drop_duplicates()\n",
    ")\n",
    "\n",
    "conflictos = catalogo_fin.groupby(\"NOMBRE_IES\")[\n",
    "    \"TIPO_FINANCIAMIENTO_HOMOLOGADO\"\n",
    "].nunique()\n",
    "\n",
    "catalogo_fin = catalogo_fin[\n",
    "    ~catalogo_fin[\"NOMBRE_IES\"].isin(conflictos[conflictos > 1].index)\n",
    "].drop_duplicates(\"NOMBRE_IES\")\n",
    "\n",
    "df_titulados[\"INSTITUCION_EDUCACION_SUPERIOR\"] = (\n",
    "    df_titulados[\"INSTITUCION_EDUCACION_SUPERIOR\"]\n",
    "    .astype(\"string\")\n",
    "    .map(normalizar_texto)\n",
    ")\n",
    "\n",
    "df_titulados = df_titulados.merge(\n",
    "    catalogo_fin.rename(columns={\n",
    "        \"NOMBRE_IES\": \"INSTITUCION_EDUCACION_SUPERIOR\",\n",
    "        \"TIPO_FINANCIAMIENTO_HOMOLOGADO\": \"FINANCIAMIENTO_HOMOLOGADO\"\n",
    "    }),\n",
    "    on=\"INSTITUCION_EDUCACION_SUPERIOR\",\n",
    "    how=\"left\",\n",
    "    validate=\"many_to_one\"\n",
    ")\n",
    "\n",
    "df_titulados[\"FINANCIAMIENTO_HOMOLOGADO\"] = (\n",
    "    df_titulados[\"FINANCIAMIENTO_HOMOLOGADO\"].fillna(\"NO CLASIFICADO\")\n",
    ")\n",
    "\n",
    "df_titulados[\"NIVEL_ACADEMICO_HOMOLOGADO\"] = homologar_nivel(\n",
    "    df_titulados[\"NIVEL_ACADEMICO\"]\n",
    ")\n",
    "\n",
    "df_titulados[\"CARRERA_HOMOLOGADA\"] = (\n",
    "    df_titulados[\"CARRERA_HOMOLOGADA\"]\n",
    "    .astype(\"string\")\n",
    "    .map(normalizar_texto)\n",
    ")\n",
    "\n",
    "df_titulados[\"ANIO\"] = pd.to_datetime(\n",
    "    df_titulados[\"FECHA_REGISTRO\"], dayfirst=True, errors=\"coerce\"\n",
    ").dt.year.astype(\"Int64\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0cecc0fa",
   "metadata": {},
   "source": [
    "## 6. Preparación de precios"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "73709127",
   "metadata": {},
   "outputs": [],
   "source": [
    "for col in [\n",
    "    \"SIGLA\",\n",
    "    \"CARRERA_HOMOLOGADA_FINAL\",\n",
    "    \"HOMOLOGADOS_NIVEL_ACADEMICO\",\n",
    "]:\n",
    "    df_precios[col] = df_precios[col].astype(\"string\").map(normalizar_texto)\n",
    "\n",
    "df_precios[\"SEMESTRE_POS\"] = pd.to_numeric(\n",
    "    df_precios[\"SEMESTRE_POS\"], errors=\"coerce\"\n",
    ").astype(\"Int64\")\n",
    "\n",
    "df_precios[\"ARANCEL\"] = df_precios[\"ARANCEL\"].apply(convertir_moneda)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0ad92d7e",
   "metadata": {},
   "source": [
    "## 7. Filtros"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "027dcb4f",
   "metadata": {},
   "outputs": [],
   "source": [
    "carrera = \"INGENIERIA EN SOFTWARE\"\n",
    "nivel = \"TERCER NIVEL\"\n",
    "provincia = None\n",
    "semestre_precios = None\n",
    "\n",
    "carrera = normalizar_texto(carrera)\n",
    "nivel = normalizar_texto(nivel)\n",
    "\n",
    "if provincia is not None:\n",
    "    provincia = normalizar_texto(provincia)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "46d68d38",
   "metadata": {},
   "source": [
    "## 8. Matriculados"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "53534a9e",
   "metadata": {},
   "outputs": [],
   "source": [
    "filtro_mat = (\n",
    "    df_matriculados[\"CARRERA_HOMOLOGADA\"].eq(carrera)\n",
    "    & df_matriculados[\"NIVEL_FORMACION_HOMOLOGADO\"].eq(nivel)\n",
    "    & df_matriculados[\"ANIO\"].between(2020, 2024)\n",
    "    & df_matriculados[\"TIPO_FINANCIAMIENTO_HOMOLOGADO\"].isin([\"PUBLICO\", \"PRIVADO\"])\n",
    ")\n",
    "\n",
    "if provincia is not None:\n",
    "    filtro_mat &= df_matriculados[\"PROVINCIA_IES\"].eq(provincia)\n",
    "\n",
    "mat = df_matriculados.loc[filtro_mat].copy()\n",
    "\n",
    "tabla_matriculados = pd.pivot_table(\n",
    "    mat,\n",
    "    index=\"TIPO_FINANCIAMIENTO_HOMOLOGADO\",\n",
    "    columns=\"ANIO\",\n",
    "    values=\"TOTAL_MATRICULADOS\",\n",
    "    aggfunc=\"sum\",\n",
    "    fill_value=0\n",
    ")\n",
    "\n",
    "anios_hist = np.arange(2020, 2025)\n",
    "\n",
    "tabla_matriculados = tabla_matriculados.reindex(\n",
    "    index=[\"PUBLICO\", \"PRIVADO\"],\n",
    "    columns=anios_hist,\n",
    "    fill_value=0\n",
    ").astype(float)\n",
    "\n",
    "for tipo in tabla_matriculados.index:\n",
    "    y = tabla_matriculados.loc[tipo, anios_hist].to_numpy(dtype=float)\n",
    "    pendiente, intercepto = np.polyfit(anios_hist, y, 1)\n",
    "    tabla_matriculados.loc[tipo, 2025] = max(0, pendiente * 2025 + intercepto)\n",
    "\n",
    "tabla_matriculados.loc[\"TOTAL\"] = tabla_matriculados.sum(axis=0)\n",
    "\n",
    "crecimientos = pd.DataFrame(index=tabla_matriculados.index)\n",
    "for anio in range(2021, 2026):\n",
    "    anterior = tabla_matriculados[anio - 1].replace(0, np.nan)\n",
    "    crecimientos[f\"CREC_{anio}\"] = ((tabla_matriculados[anio] / anterior) - 1) * 100\n",
    "\n",
    "crecimientos[\"CREC_PROMEDIO\"] = crecimientos.mean(axis=1, skipna=True)\n",
    "\n",
    "resultado_matriculados = tabla_matriculados.round(0).astype(\"Int64\")\n",
    "for col in crecimientos.columns:\n",
    "    resultado_matriculados[col] = crecimientos[col].round(2)\n",
    "\n",
    "display(resultado_matriculados.rename(columns={2025: \"2025*\"}))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "122d3729",
   "metadata": {},
   "source": [
    "## 9. Titulados"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9d6bef78",
   "metadata": {},
   "outputs": [],
   "source": [
    "filtro_tit = (\n",
    "    df_titulados[\"CARRERA_HOMOLOGADA\"].eq(carrera)\n",
    "    & df_titulados[\"NIVEL_ACADEMICO_HOMOLOGADO\"].eq(nivel)\n",
    "    & df_titulados[\"ANIO\"].between(2020, 2024)\n",
    ")\n",
    "\n",
    "tit = df_titulados.loc[filtro_tit].copy()\n",
    "\n",
    "if tit.empty:\n",
    "    print(\"No hay titulados con los filtros seleccionados.\")\n",
    "else:\n",
    "    tabla_titulados = pd.crosstab(\n",
    "        tit[\"FINANCIAMIENTO_HOMOLOGADO\"],\n",
    "        tit[\"ANIO\"]\n",
    "    )\n",
    "\n",
    "    tabla_titulados = tabla_titulados.reindex(\n",
    "        index=[\"PUBLICO\", \"PRIVADO\", \"NO CLASIFICADO\"],\n",
    "        columns=np.arange(2020, 2025),\n",
    "        fill_value=0\n",
    "    ).astype(float)\n",
    "\n",
    "    display(tabla_titulados.round(0).astype(\"Int64\"))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ae688849",
   "metadata": {},
   "source": [
    "## 10. Precios"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2f1966d0",
   "metadata": {},
   "outputs": [],
   "source": [
    "filtro_p = (\n",
    "    df_precios[\"CARRERA_HOMOLOGADA_FINAL\"].eq(carrera)\n",
    "    & df_precios[\"HOMOLOGADOS_NIVEL_ACADEMICO\"].eq(nivel)\n",
    ")\n",
    "\n",
    "precios_base = df_precios.loc[filtro_p].copy()\n",
    "\n",
    "if precios_base.empty:\n",
    "    print(\"No hay precios para la carrera/nivel.\")\n",
    "else:\n",
    "    semestre_usado = (\n",
    "        int(precios_base[\"SEMESTRE_POS\"].dropna().max())\n",
    "        if semestre_precios is None\n",
    "        else int(semestre_precios)\n",
    "    )\n",
    "\n",
    "    precios = precios_base[\n",
    "        precios_base[\"SEMESTRE_POS\"].eq(semestre_usado)\n",
    "    ].copy()\n",
    "\n",
    "    precios[\"ARANCEL_VALIDO\"] = precios[\"ARANCEL\"].where(\n",
    "        precios[\"ARANCEL\"] > 0, np.nan\n",
    "    )\n",
    "\n",
    "    tabla_precios = (\n",
    "        precios.groupby(\"SIGLA\", as_index=False)\n",
    "        .agg(\n",
    "            NUM_REGISTROS=(\"SIGLA\", \"size\"),\n",
    "            ARANCEL_MINIMO=(\"ARANCEL_VALIDO\", \"min\"),\n",
    "            ARANCEL_PROMEDIO=(\"ARANCEL_VALIDO\", \"mean\"),\n",
    "            ARANCEL_MAXIMO=(\"ARANCEL_VALIDO\", \"max\"),\n",
    "        )\n",
    "    )\n",
    "\n",
    "    display(tabla_precios.sort_values(\"ARANCEL_PROMEDIO\", na_position=\"last\"))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a3819ed7",
   "metadata": {},
   "source": [
    "## 11. Gráfico de matriculados"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "08395771",
   "metadata": {},
   "outputs": [],
   "source": [
    "if 'tabla_matriculados' in globals() and not tabla_matriculados.empty:\n",
    "    datos = tabla_matriculados.loc[\n",
    "        [\"PUBLICO\", \"PRIVADO\"], [2020, 2021, 2022, 2023, 2024, 2025]\n",
    "    ]\n",
    "\n",
    "    x = np.arange(6)\n",
    "    publico = datos.loc[\"PUBLICO\"].to_numpy(dtype=float)\n",
    "    privado = datos.loc[\"PRIVADO\"].to_numpy(dtype=float)\n",
    "    total = publico + privado\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(11, 6))\n",
    "    ax.bar(x, publico, label=\"Público\")\n",
    "    ax.bar(x, privado, bottom=publico, label=\"Privado\")\n",
    "    ax.plot(x, total, marker=\"o\", linewidth=2, label=\"Total\")\n",
    "\n",
    "    ax.set_xticks(x)\n",
    "    ax.set_xticklabels([\"2020\", \"2021\", \"2022\", \"2023\", \"2024\", \"2025*\"])\n",
    "    ax.set_ylabel(\"Matriculados\")\n",
    "    ax.set_title(f\"Evolución de matriculados - {carrera.title()}\")\n",
    "    ax.legend()\n",
    "    ax.grid(axis=\"y\", alpha=0.2)\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n"
   ]
  },
