[sql]
server = "SNBI03"
database = "BDD_IDM"
trusted_connection = true
encrypt = true
trust_server_certificate = true
# driver = "ODBC Driver 17 for SQL Server"
# SNBI03 usa un certificado interno: mantener cifrado y aceptar ese certificado.
# Para otro servidor con certificado validable, usar trust_server_certificate = false.

[tendencias]
# PostgreSQL del proyecto Tendencias (Railway): mismo valor que DATABASE_URL en su .env.
# Solo se leen las tablas de Google Trends (SELECT). También acepta la variable TENDENCIAS_DATABASE_URL.
database_url = ""
