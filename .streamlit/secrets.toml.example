[sql]
server = "SNBI03"
database = "BDD_IDM"
trusted_connection = true
encrypt = true
trust_server_certificate = true
# driver = "ODBC Driver 17 for SQL Server"
# SNBI03 usa un certificado interno: mantener cifrado y aceptar ese certificado.
# Para otro servidor con certificado validable, usar trust_server_certificate = false.
